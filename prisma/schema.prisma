// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model xauthtoken {
  id        String   @id
  username  String   @unique
  authToken String   @unique @map("auth_token")
  ct0       String
  isActive  Boolean  @default(true) @map("is_active")
  userId    String?  @map("user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([userId])
  @@map("x_auth_token")
}

model AdminUser {
  id           BigInt   @id @default(autoincrement())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         String   @default("viewer")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("admin_users")
}

model Project {
  userId          String    @id
  name            String
  username        String    @unique
  twitterName     String?   @map("twitter_name")
  followers       Int       @default(0)
  following       Int       @default(0)
  tweets          Int       @default(0)
  description     String?
  website         String?
  github          String?
  chain           String?
  tokenAddress    String?   @map("token_address")
  profileImageUrl     String?   @map("profile_image_url")
  fxTwitterCursorTop  String?   @map("fxtwitter_cursor_top")
  lastFetchedAt       DateTime? @map("last_fetched_at") @db.Timestamptz

  // Live X profile fields. `description` is the operator's own note and is
  // never overwritten by the poller; `twitterBio` is whatever X currently
  // shows on the profile.
  twitterBio      String?   @map("twitter_bio")
  location        String?
  isBlueVerified  Boolean   @default(false) @map("is_blue_verified")

  // active | suspended | unavailable | not_found — see services/tracking.ts
  status          String    @default("active")
  statusReason    String?   @map("status_reason")
  statusChangedAt DateTime? @map("status_changed_at") @db.Timestamptz
  // Last cycle in which X actually returned this user.
  lastSeenAt      DateTime? @map("last_seen_at") @db.Timestamptz
  // Consecutive cycles the user was missing. Debounces flaky lookups.
  missedChecks    Int       @default(0) @map("missed_checks")

  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  feedItems       FeedItem[]
  snapshots       ProjectSnapshot[]
  changes         ProjectChange[]
  rollups         ProjectMetricRollup[]
  follows         UserFollow[]
  filters         Filter[]

  @@index([chain])
  @@index([status])
  @@map("projects")
}

/// Point-in-time metrics, written only when a value actually moves. Growth over
/// any window = current value minus the newest snapshot at or before the
/// window start, so sparse rows are enough and the table stays flat for idle
/// accounts.
model ProjectSnapshot {
  id         BigInt   @id @default(autoincrement())
  projectId  String   @map("project_id")
  project    Project  @relation(fields: [projectId], references: [userId], onDelete: Cascade)
  followers  Int
  following  Int
  tweets     Int
  status     String   @default("active")
  capturedAt DateTime @default(now()) @map("captured_at") @db.Timestamptz

  @@index([projectId, capturedAt(sort: Desc)])
  @@index([capturedAt(sort: Desc)])
  @@map("project_snapshots")
}

/// Append-only log of profile edits (handle, display name, bio, avatar, …)
/// and status transitions, so the UI can show what changed inside any
/// time window.
model ProjectChange {
  id        BigInt   @id @default(autoincrement())
  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [userId], onDelete: Cascade)
  /// username | name | bio | avatar | website | location | verified | status
  field     String
  oldValue  String?  @map("old_value")
  newValue  String?  @map("new_value")
  changedAt DateTime @default(now()) @map("changed_at") @db.Timestamptz

  @@index([projectId, changedAt(sort: Desc)])
  @@index([projectId, field, changedAt(sort: Desc)])
  @@index([changedAt(sort: Desc)])
  @@index([field])
  @@map("project_changes")
}

/// Bucketed follower/following/tweet counts for trend charts and growth
/// baselines. `granularity` is "hour" or "day"; values are the last poller
/// observation inside the bucket. Upserted per cycle — jitter updates the
/// bucket instead of creating rows, so the table is size-bounded.
model ProjectMetricRollup {
  projectId   String   @map("project_id")
  project     Project  @relation(fields: [projectId], references: [userId], onDelete: Cascade)
  granularity String
  bucketStart DateTime @map("bucket_start") @db.Timestamptz
  followers   Int
  following   Int
  tweets      Int

  @@unique([projectId, granularity, bucketStart])
  @@index([granularity, bucketStart])
  @@map("project_metric_rollups")
}

/// A browser/device endpoint that opted into Web Push. No application account
/// is required yet, so subscriptions are intentionally device-scoped.
model PushSubscription {
  id             BigInt    @id @default(autoincrement())
  endpoint       String    @unique
  p256dh         String
  auth           String
  expirationTime DateTime? @map("expiration_time") @db.Timestamptz
  userAgent      String?   @map("user_agent")
  userId         String?   @map("user_id")
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([userId])
  @@map("push_subscriptions")
}

/// Operator-managed detection phrases. `phrase` is stored trimmed + lowercase;
/// matching is case-insensitive with word boundaries (see src/lib/keywords.ts).
model Keyword {
  id        BigInt   @id @default(autoincrement())
  phrase    String   @unique
  tag       String?
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("keywords")
}

model FeedItem {
  id         String   @id
  projectId  String   @map("project_id")
  project    Project  @relation(fields: [projectId], references: [userId], onDelete: Cascade)
  username   String
  text       String
  tweetUrl   String   @map("tweet_url")
  postedAt   DateTime @map("posted_at") @db.Timestamptz
  likes      Int      @default(0)
  reposts    Int      @default(0)
  replies    Int      @default(0)
  payload    Json
  detectedAt DateTime @default(now()) @map("detected_at") @db.Timestamptz
  /// { phrase, tag }[] matched at ingest; DB NULL = never classified,
  /// JSON null = classified with no matches (see Global Constraints).
  matchedKeywords Json? @map("matched_keywords")
  matchedCount    Int   @default(0) @map("matched_count")

  @@index([detectedAt(sort: Desc)])
  @@index([projectId])
  @@index([projectId, postedAt(sort: Desc)])
  @@index([matchedCount, detectedAt(sort: Desc)])
  @@map("feed_items")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  displayName  String?  @map("display_name")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  sessions    UserSession[]
  invitesMade UserInvite[]  @relation("InvitedBy")
  inviteUsed  UserInvite?   @relation("InviteAcceptedBy")
  follows     UserFollow[]
  filters     Filter[]
  mutes       MuteKeyword[]
  pushSubs    PushSubscription[]

  @@map("users")
}

model UserSession {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  lastUsedAt DateTime @default(now()) @map("last_used_at") @db.Timestamptz

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model UserInvite {
  id           String    @id @default(cuid())
  tokenHash    String    @unique @map("token_hash")
  invitedById  String    @map("invited_by_id")
  invitedBy    User      @relation("InvitedBy", fields: [invitedById], references: [id])
  acceptedById String?   @unique @map("accepted_by_id")
  acceptedBy   User?     @relation("InviteAcceptedBy", fields: [acceptedById], references: [id])
  email        String?
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  acceptedAt   DateTime? @map("accepted_at")

  @@map("user_invites")
}

model UserFollow {
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [userId], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@id([userId, projectId])
  @@index([projectId])
  @@map("user_follows")
}

model Filter {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  kind      String
  projectId String?  @map("project_id")
  project   Project? @relation(fields: [projectId], references: [userId], onDelete: Cascade)
  pattern   String?
  action    String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId])
  @@index([userId, kind, isActive])
  @@map("filters")
}

model MuteKeyword {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pattern   String
  isRegex   Boolean  @default(false) @map("is_regex")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId])
  @@map("mute_keywords")
}

model TelegramBinding {
  chatId    BigInt   @id @map("chat_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId])
  @@map("telegram_bindings")
}
