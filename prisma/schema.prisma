// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model xauthtoken {
  id        String   @id
  username  String   @unique
  authToken String   @unique @map("auth_token")
  ct0       String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("x_auth_token")
}

model AdminUser {
  id           BigInt   @id @default(autoincrement())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         String   @default("viewer")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("admin_users")
}

model Project {
  userId          String    @id
  name            String
  username        String    @unique
  twitterName     String?   @map("twitter_name")
  followers       Int       @default(0)
  following       Int       @default(0)
  tweets          Int       @default(0)
  description     String?
  website         String?
  github          String?
  chain           String?
  tokenAddress    String?   @map("token_address")
  profileImageUrl     String?   @map("profile_image_url")
  fxTwitterCursorTop  String?   @map("fxtwitter_cursor_top")
  lastFetchedAt       DateTime? @map("last_fetched_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  feedItems       FeedItem[]

  @@index([chain])
  @@map("projects")
}

model FeedItem {
  id         String   @id
  projectId  String   @map("project_id")
  project    Project  @relation(fields: [projectId], references: [userId], onDelete: Cascade)
  username   String
  text       String
  tweetUrl   String   @map("tweet_url")
  postedAt   DateTime @map("posted_at") @db.Timestamptz
  likes      Int      @default(0)
  reposts    Int      @default(0)
  replies    Int      @default(0)
  payload    Json
  detectedAt DateTime @default(now()) @map("detected_at") @db.Timestamptz

  @@index([detectedAt(sort: Desc)])
  @@index([projectId])
  @@map("feed_items")
}
