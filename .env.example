# PostgreSQL connection used by Prisma
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/x_feed"

# Generate once with: npx web-push generate-vapid-keys
# Use a contact URI, e.g. mailto:ops@example.com
VAPID_SUBJECT="mailto:ops@example.com"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Set _NEW to both old and new for 30-day rotation. Restart the server
# after switching — web-push only supports one active VAPID detail at a time.
# VAPID_PUBLIC_KEY_NEW=
# VAPID_PRIVATE_KEY_NEW=

# Operator token for /admin routes (invites, x-auth linking, health).
# Required — admin routes fail closed with 503 while this is unset.
ADMIN_TOKEN=""

# Secret external services must send in the X-Webhook-Secret header
WEBHOOK_SECRET=""
